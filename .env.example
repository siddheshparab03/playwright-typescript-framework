# Copy this file to .env and fill in real values.
# .env is ignored by Git so passwords never reach GitHub.
BASE_URL=https://rahulshettyacademy.com

# Main test account: login and product tests
USER_EMAIL=your-email@example.com
USER_PASSWORD=your-password

# Separate account used ONLY by the cart tests. The site empties an account's cart
# whenever it logs in, so the cart tests need an account no other test uses.
CART_USER_EMAIL=your-cart-test-email@example.com
CART_USER_PASSWORD=your-cart-test-password
